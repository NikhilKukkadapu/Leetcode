class Solution {
    public boolean divisorGame(int n) {
        boolean[] dp = new boolean[n + 1];

        for (int i = 2; i <= n; i++) {
            for (int x = 1; x * x <= i; x++) {
                if (i % x == 0) {
                    if (!dp[i - x]) {
                        dp[i] = true;
                        break;
                    }
                }
            }
        }

        return dp[n];
    }
}
                    (OR)
class Solution {
    public boolean divisorGame(int n) {
        return n % 2 == 0;
    }
}
