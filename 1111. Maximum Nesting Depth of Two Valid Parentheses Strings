class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        int n = seq.length();
        int[] list = new int[n];
        int depth = 0;
        for (int i = 0; i < n; i++) {
            char ch = seq.charAt(i);
            if (ch == '(') {
                list[i] = depth % 2;
                depth++;
            } else {
                depth--;
                list[i] = depth % 2;
            }
        }
        return list;
    }
}
