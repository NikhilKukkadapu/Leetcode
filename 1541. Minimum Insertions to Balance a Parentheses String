class Solution {
    public int minInsertions(String s) {
        int count = 0;
        int ans = 0;
        int n = s.length();
        for (int i = n - 1; i >= 0; i--) {
            if (s.charAt(i) == ')') {
                count++;
            } else {
                if (count == 0) {
                    ans += 2;
                } else if ((count & 1) == 1) {
                    count--;
                    ans++;
                } else {
                    count -= 2;
                }
            }
        }
        if ((count & 1) == 1) {
            return ans + count / 2 + 2;
        }
        return ans + count / 2;
    }
}
