class Solution {
    public int countTriples(int n) {
        int count = 0;
        for (int a = 1; a <= n; a++) {
            int aSquare = a * a;
            for (int b = 1; b <= n; b++) {
                int SumSquares = aSquare + (b * b);
                int c = (int) Math.sqrt(SumSquares);
                if (c <= n && c * c == SumSquares)
                    count++;
            }
        }
        return count;
    }
}
