class Solution {
    public int maxProduct(int n) {
        //int temp = n ;
        int first = 0;
        int second = 0;
        int product = 1;
        while(n != 0){
            int remainder = n % 10;
            if(remainder > first){
                second = first;
                first = remainder;
            }
            else if(remainder > second){
                second = remainder;
            }
            n /= 10;
        }
        return first * second;
    }
}
