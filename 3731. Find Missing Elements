class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        Arrays.sort(nums);
        ArrayList<Integer> list = new ArrayList<>();
        int start = nums[0];
        int end = nums[nums.length - 1];
        HashSet<Integer> set = new HashSet<>();
        for(int num : nums){
            set.add(num);
        }
        for(int i = start ; i <= end ; i++){
            if(!set.contains(i)){
                list.add(i);
            }
        }
        return list;
    }
}
