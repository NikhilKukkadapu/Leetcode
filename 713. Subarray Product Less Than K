class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        if(k <= 1) return 0;
        int count = 0;
        int product = 1;
        int left = 0;
        for(int right = 0 ; right < nums.length ; right++){
            product *= nums[right];
            while(product >= k){
                product /= nums[left];
                left++;
            }
            count += right - left + 1;
        }
        return count;
    }
}

                          (OR)
                        
class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        int count = 0;
        for(int i = 0 ; i < nums.length ; i++){
            int prefixSum = 1;
            for(int j = i ; j >= 0; j--){
                prefixSum *= nums[j];
                if(prefixSum < k){
                    count++;
                }
                else{
                    break;
                }
            }
        }
        return count;
    }
}
