class Solution {
    private boolean selfdivide(int num) {
        int n = num;
        while (n > 0) {
            int rem = n % 10;
            if (rem == 0 || num % rem != 0) {
                return false;
            }
            n = n / 10;
        }
        return true;
    }

    public List<Integer> selfDividingNumbers(int left, int right) {
        ArrayList<Integer> list = new ArrayList<>();
        for (int i = left; i <= right; i++) {
            if (selfdivide(i) == true) {
                list.add(i);
            }
        }
        return list;
    }
}
